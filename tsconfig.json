{
  "compilerOptions": {
    "module": "es2022",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "declaration": false,
    "lib": ["ES2020"],
    "types": ["node"],
    "target": "es6"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
  ]
}
